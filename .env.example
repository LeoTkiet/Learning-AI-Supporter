# ==============================================================================
# HỆ THỐNG HỖ TRỢ HỌC TẬP ĐA MÔN ÁP DỤNG AI (TOÁN, LÝ, HÓA)
# File mẫu cấu hình biến môi trường
# ==============================================================================

# -----------------
# 1. Supabase Config (PostgreSQL & Auth)
# -----------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# -----------------
# 2. Google Gemini AI Config
# -----------------
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# -----------------
# 3. Backend API Config (FastAPI)
# -----------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8501"]
JWT_SECRET=your-jwt-secret-key-super-secure
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -----------------
# 4. OCR Config
# -----------------
# Tesseract OCR engine mode (default: local path if installed, or vision api)
TESSERACT_CMD_PATH=tesseract
GOOGLE_VISION_CREDENTIALS_JSON=

# -----------------
# 5. Frontend Config (Next.js)
# -----------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
